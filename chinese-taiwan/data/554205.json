_full_url":"https://asia-tw.onepiece-cardgame.com/images/cardlist/card/OP17-109_p1.png?261016","img_url":"../images/cardlist/card/OP17-109_p1.png?261016","name":"夏洛特・普琳","pack_id":"554205","power":4000,"rarity":"Special","trigger":"【觸發器】從自己的卡組上面查看5張卡片，公開最多1張擁有《BIG MOM海賊團》特徵的卡片，並加入手牌。之後，將其餘卡片依任意順序放到卡組下面。","types":["BIG MOM海賊團"]},{"attributes":["Special"],"block_number":3,"category":"Character","colors":["Blue"],"cost":4,"counter":null,"effect":"【防禦】(對手攻擊後，將這張卡片置為休息狀態即可使攻擊的對象換成這張卡片) 【登場時】從自己的卡組上面查看3張卡片，並任意變換排列順序放到卡組上面或下面。之後，附加最多1張休息狀態的咚‼卡在1張自己擁有《王下七武海》特徵的領航卡或角色卡。","id":"ST17-004_p3","img_full_url":"https://asia-tw.onepiece-cardgame.com/images/cardlist/card/ST17-004_p3.png?261016","img_url":"../images/cardlist/card/ST17-004_p3.png?261016","name":"波雅・漢考克","pack_id":"554205","power":6000,"rarity":"Special","trigger":null,"types":["王下七武海","九蛇海賊團"]}]